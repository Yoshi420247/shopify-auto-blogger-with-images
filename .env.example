# Shopify Configuration
# Get your Admin API token from: Shopify Admin > Settings > Apps and sales channels > Develop apps
SHOPIFY_ADMIN_API_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_STORE_DOMAIN=oilslickpad.com

# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Search Console Configuration
# Required for the daily Search Console checker (search-console-checker.yml)
#
# Setup steps:
# 1. Go to https://console.cloud.google.com/
# 2. Create a project (or use existing) and enable "Google Search Console API"
# 3. Go to IAM & Admin > Service Accounts > Create Service Account
# 4. Create a JSON key for the service account and download it
# 5. Go to https://search.google.com/search-console/ > Settings > Users and permissions
# 6. Add the service account email (e.g., my-bot@project.iam.gserviceaccount.com) as a Full user
# 7. Paste the entire JSON key contents below (or set as a GitHub Actions secret)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Optional: Override the site URL used for Search Console queries
# By default uses "sc-domain:oilslickpad.com" (domain property)
# Uncomment to use a specific URL property instead:
# GSC_SITE_URL=https://oilslickpad.com/

# Optional: Day of week to write product-targeted blogs (0=Sun, 1=Mon, ..., 6=Sat)
# PRODUCT_BLOG_DAY=1
